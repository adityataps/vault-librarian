# ── LLM Provider ─────────────────────────────────────────────
# Provider: copilot | anthropic | ollama
LIBRARIAN_LLM_PROVIDER=copilot
# Fast model — used for real-time pipeline agents (on every file save)
LIBRARIAN_LLM_MODEL=gpt-4o-mini
# Heavy model — used for scheduled/async jobs (audits, briefs, consolidation)
# Falls back to LIBRARIAN_LLM_MODEL if not set
LIBRARIAN_LLM_MODEL_HEAVY=gpt-4o
LIBRARIAN_LLM_API_KEY=your-github-token-here

# ── Embeddings ───────────────────────────────────────────────
# "openai" = text-embedding-3-small via GitHub Models API (requires LIBRARIAN_LLM_API_KEY)
# "local"  = HuggingFace all-MiniLM-L6-v2 (runs locally, no API key needed)
LIBRARIAN_EMBEDDING_PROVIDER=openai

# ── Vault ────────────────────────────────────────────────────
LIBRARIAN_VAULT_PATH=/Users/you/Documents/Obsidian-Vault
# LIBRARIAN_VAULT_EXCLUDED_FOLDERS=.obsidian,.git,.librarian,Librarian,Attachments
# LIBRARIAN_VAULT_EXCLUDED_FILES=CLAUDE.md

# ── Service ──────────────────────────────────────────────────
LIBRARIAN_SECRET=change-me
LIBRARIAN_LOG_LEVEL=INFO

# ── Debounce (seconds) ───────────────────────────────────────
# LIBRARIAN_DEBOUNCE_STANDARD=3.0     # standard file-save pipeline trigger
# LIBRARIAN_DEBOUNCE_DIRECTIVE=0.5    # inline <agent-...> directives
LIBRARIAN_DEBOUNCE_INBOX=30.0         # delay before processing checked Inbox items

# ── Inbox ────────────────────────────────────────────────────
# Hours to keep executed items in Inbox before auto-removal (during consolidation)
LIBRARIAN_INBOX_RETENTION_HOURS=48

# ── Agents ───────────────────────────────────────────────────
# Comma-separated list of agents to enable (default: all)
# LIBRARIAN_ENROLLED_AGENTS=librarian,formatter,meeting_enricher,linker,moc_maintainer,inline_directive,scaffolder,auditor,daily_brief,weekly_review
# LIBRARIAN_AUTONOMY_DEFAULT=supervised

# ── Scheduler (cron expressions) ─────────────────────────────
# LIBRARIAN_AUDITOR_SCHEDULE=0 2 * * *
# LIBRARIAN_DAILY_BRIEF_SCHEDULE=0 7 * * *
# LIBRARIAN_WEEKLY_REVIEW_SCHEDULE=0 18 * * 0

# ── Ollama (optional, for local models) ──────────────────────
# ENABLE_OLLAMA=true
# OLLAMA_MODELS=llama3.2
